# QR encoding parameters.
# Defaults are the same as the `qrencode` CLI defaults.
# NOTE: systemd does not support trailing comments; keep comments on their own lines.

# Error correction level: L | M | Q | H
QR_LEVEL=L

# Symbol version: 0 = auto (smallest that fits), 1..40 = fixed
QR_VERSION=0

# string = QRcode_encodeString(hint=QR_MODE_8), 8bit = QRcode_encodeString8bit, kanji = hint QR_MODE_KANJI
QR_MODE=string
QR_CASESENSITIVE=1

# Line break sent to the encoder: lf | crlf | keep
QR_NEWLINE=lf

# Quiet zone in modules (display only, does not change the matrix)
QR_MARGIN=4

MAX_INPUT_BYTES=4096

# Welcome message shown at the top of the page.
# Comment out or leave empty to hide it.
WELCOME_MESSAGE=
